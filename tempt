<!-- css -->

/* card 2_1 */
.card2_1 {
  box-sizing: border-box;
  width: 190px;
  height: 254px;
  background-image: url("Assets/Images/card2_1.jpg");
  background-size: cover;
  background-repeat: no-repeat;
  box-shadow: 0px 0px 10px 5px  rgba(0, 0, 0, 0.205);
  backdrop-filter: blur(6px);
  border-radius: 17px;
  text-align: center;
  cursor: pointer;
  transition: all 0.5s;
  display: flex;
  align-items: center;
  justify-content: center;
  user-select: none;
  font-weight: bolder;
  color: black;
}

.card2_1:hover {
  transform: scale(1.05);
}

.card2_1:active {
  transform: scale(0.95) rotateZ(1.7deg);
}
/* card 2_1 */

